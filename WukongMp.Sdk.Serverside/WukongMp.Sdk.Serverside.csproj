<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Wukong stays on SDK v1 and keeps its assembly names, so the layer is declared instead of derived. -->
        <ReadyMLayer>V1</ReadyMLayer>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- The core SDK. Defaults to the submodule here; an uberrepo overrides it
         so one checkout is shared across every consumer. -->
    <PropertyGroup>
        <CoreSdkRoot Condition="'$(CoreSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\readym-core-sdk</CoreSdkRoot>
    </PropertyGroup>

<ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Sdk.Serverside\ReadyM.Sdk.Serverside.csproj"/>
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Sdk.V1.Serverside\ReadyM.Sdk.V1.Serverside.csproj"/>
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Sdk.V1.Generators\ReadyM.Sdk.V1.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
        <ProjectReference Include="..\ReadyM.Wukong.Common\ReadyM.Wukong.Common.csproj" />
    </ItemGroup>

</Project>
